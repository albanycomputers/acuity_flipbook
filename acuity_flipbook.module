<?php

/**
 * @file
 * Provides a field formatter to display PDFs as interactive flipbooks.
 */

/**
 * Implements hook_field_formatter_info().
 */
function acuity_flipbook_field_formatter_info(): array {
  return [
    'acuity_flipbook_pdf' => [
      'label' => t('Acuity 3D Flipbook (PDF)'),
      'field types' => ['file'],
      'description' => t('Displays each PDF file as an interactive 3D flipbook.'),
    ],
  ];
}

/**
 * Implements hook_field_formatter_view().
 */
function acuity_flipbook_field_formatter_view($entity_type, $entity, array $field, array $instance, $langcode, array $items, array $display): array {
  $element = [];

  if ($display['type'] === 'acuity_flipbook_pdf') {
    foreach ($items as $delta => $item) {
      if (strpos($item['filemime'], 'pdf') === FALSE) {
        continue;
      }

      $file_url = file_create_url($item['uri']);

      $element[$delta] = [
        '#type' => 'markup',
        // The book sizes itself from the PDF and the space it is placed in.
        '#markup' => sprintf(
          '<div class="acuity-flipbook-container" data-pdf-url="%s"></div>',
          check_url($file_url)
        ),
        '#attached' => [
          'library' => [
            // We now strictly load our own standalone library bundle
            ['acuity_flipbook', 'pageflip_init'],
          ],
        ],
      ];
    }
  }

  return $element;
}

/**
 * Implements hook_library_info().
 */
function acuity_flipbook_library_info(): array {
  // PDF.js (6.4.299) is not declared here: it is an ES module, imported by
  // acuity_flipbook.init.js itself.
  $libraries['pageflip_init'] = [
    'title' => 'Acuity PageFlip Integration',
    // NULL: core then stamps the site's cache-busting query string, so an
    // edited init.js reaches browsers on the next cache flush.
    'version' => NULL,
    'js' => [
      // Pinned: unversioned, any upstream release would change the module.
      'https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js' => ['type' => 'external'],
      backdrop_get_path('module', 'acuity_flipbook') . '/js/acuity_flipbook.init.js' => [],
    ],
    'css' => [
      backdrop_get_path('module', 'acuity_flipbook') . '/css/acuity_flipbook.css' => [],
    ],
    'dependencies' => [
      ['system', 'jquery'],
    ],
  ];

  return $libraries;
}
